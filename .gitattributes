# ---------------------------------------------------------------------------
# Line endings
# The repository stores LF for all text files; each OS checks out what it
# needs. Without this, a clone with core.autocrlf unset reports every text
# file as modified (whole-file CRLF churn).
# ---------------------------------------------------------------------------
* text=auto

# Must stay CRLF on every platform (Visual Studio / Windows tooling)
*.sln     text eol=crlf
*.csproj  text eol=crlf
*.esproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Must stay LF on every platform
*.sh        text eol=lf
Dockerfile  text eol=lf
.githooks/* text eol=lf

# ---------------------------------------------------------------------------
# Binary assets: never diff, never munge, never line-ending-convert
# ---------------------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.mp3   binary
*.wav   binary
*.ogg   binary
*.mp4   binary
*.glb   binary
*.gltf  binary
*.stl   binary
*.obj   binary
*.bin   binary
*.pkl   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.dll   binary
*.exe   binary
*.pdb   binary

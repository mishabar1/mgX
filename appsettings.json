{
  "Jwt": {
    "Issuer": "MultiGameX",
    "Audience": "MultiGameX",
    "ExpireHours": 24
    // Jwt:Key is intentionally NOT stored here. Provide it via the environment
    // variable Jwt__Key in production. In Development a throwaway key is used (Program.cs).
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

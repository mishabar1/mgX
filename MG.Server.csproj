<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- POC: keep nullable ANNOTATIONS (so `?`/`!` are valid) but disable the nullable
         WARNINGS — the original domain model predates nullable and would need 60+
         annotations otherwise. Switch back to `enable` if you want to harden null-safety. -->
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>befa8c39-72de-4e09-9e8b-db7b22dda28e</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <!-- We serve wwwroot + GameContent via explicit UseStaticFiles(PhysicalFileProvider) in
         Program.cs, NOT the Static Web Assets pipeline. Disabling SWA stops `dotnet watch` from
         reading a stale staticwebassets manifest in obj/ and trying to file-watch asset folders
         that no longer exist (the cause of the "directory does not exist" crash). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Swagger/OpenAPI UI. v10.x is the first release supporting .NET 10. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- VS container tooling target. -->
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.2" />
    <!-- Auth (C2): self-issued JWT bearer authentication. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- Persistence (C4): EF Core + SQLite. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Ensure native SQLite provider is pinned to a non-vulnerable build. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12-pre20260709125052" />
  </ItemGroup>

  <!-- Game CONTENT (art/models/sounds/heads) is served by the server from GameContent/ — the
       single source of truth. Ship it with the published app.
       The Remove BEFORE the Include is required, not cosmetic: the Web SDK's implicit Content glob
       already picks up some file types under the project dir (.json among them), so a GameContent
       file of such a type would be included twice and fail the build with NETSDK1022. Dropping the
       SDK's copies first and re-adding the whole tree on our own terms keeps ONE item per file
       whatever extensions a game's assets use (Small World ships regions_N.json). -->
  <ItemGroup>
    <!-- GameContent holds ASSETS only. Never compile code from it: a stray .cs scratch file in an
         asset folder would otherwise be built into the server (and can even add a second entry
         point). Assets are shipped as Content by the two lines below. -->
    <Compile Remove="GameContent\**" />
    <Content Remove="GameContent\**" />
    <Content Include="GameContent\**" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <!--
    ==================================================================================
    UPGRADE NOTES (.NET 7 -> .NET 10)  — packages intentionally REMOVED:

    * Microsoft.AspNet.SignalR.Client 2.4.3   - LEGACY ASP.NET (not Core) SignalR, unused.
    * Microsoft.AspNet.SignalR.Core   2.4.3   - LEGACY ASP.NET (not Core) SignalR, unused.
    * Microsoft.AspNetCore.SignalR.Client.Core - SignalR *client*; this is a server. Server-side
                                                 SignalR ships in the ASP.NET Core shared framework,
                                                 so no package is needed for AddSignalR()/MapHub().
    * Microsoft.AspNetCore.SpaServices        3.1.32 - obsolete (ASP.NET Core 3.1).
    * Microsoft.AspNetCore.SpaServices.Extensions - UseSpa() replaced by the native
                                                    app.MapFallbackToFile("index.html") in Program.cs.
    * Microsoft.AspNetCore.OpenApi            - redundant with Swashbuckle; mixing the two causes
                                                 conflicts on .NET 10. (Consider migrating to the
                                                 native OpenAPI stack later and dropping Swashbuckle.)
    * SciSharp.TensorFlow.Redist / TensorFlow.NET / TensorFlow.Keras
                                              - large native dependency used ONLY by the experimental
                                                UserBL.TensofFlowTest debug endpoint. Removed to get a
                                                clean build and a small container image for DigitalOcean.
                                                The experiment code is preserved (commented) in UserBL.cs.
                                                To restore it, re-add these packages at .NET 10-compatible
                                                versions and un-comment the method body.
    ==================================================================================
  -->
</Project>
